# Vercel/Supabase frontend configuration. These are safe to expose to the
# browser only because Supabase Row Level Security is enabled in supabase/schema.sql.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Local Python/MCP server only; never use these as VITE_* variables.
DATABASE_PATH=data/club.sqlite3
WORKOUT_IMPORT_TOKEN=replace-with-a-long-random-secret
ALLOW_TEST_LOGIN=true
TEST_LOGIN_EMAIL=test@example.com
TEST_LOGIN_PASSWORD=RunClub-test-2026!

# Local MCP publisher only. Never expose this key to Vercel/browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
